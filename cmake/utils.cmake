function(add_sources result curdir)
    file(GLOB children RELATIVE ${curdir} ${curdir}/*)
    set(all_files "")
    foreach(child ${children})
        if(IS_DIRECTORY ${curdir}/${child})
            add_sources(sub_files "${curdir}/${child}")
            list(APPEND all_files ${sub_files})
        else()
            list(APPEND all_files ${curdir}/${child})
        endif()
    endforeach()
    set(${result} ${all_files} PARENT_SCOPE)
endfunction()
