            VALUE "OriginalFilename", "Pheromone.exe\0"
            VALUE "ProductName", "Pheromone\0"
            VALUE "ProductVersion", "1.0.0.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END